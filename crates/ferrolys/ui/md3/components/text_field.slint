// MD3 TextField (outlined): валидация, focus ring, суффикс-слот,
// необязательный переключатель показа пароля.

import { Theme } from "../tokens.slint";

export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> valid: true;
    in property <bool> reveal-toggle: false;
    callback accepted();

    property <bool> revealed: false;
    property <bool> focused: input.has-focus;
    property <bool> secret: password && !revealed;

    height: 56px;
    border-radius: Theme.corner_xs;
    background: Theme.colors.surface_container_highest;
    border-width: focused ? 2px : 1px;
    border-color: !valid ? Theme.colors.error
        : focused ? Theme.colors.primary
        : Theme.colors.outline;
    animate border-color, border-width { duration: Theme.dur_short; }

    // Placeholder.
    if (input.text == "" && root.placeholder != ""): Text {
        x: 16px;
        width: parent.width - 32px - (reveal-toggle ? 40px : 0px);
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.colors.on_surface_variant;
        font-family: Theme.font_family;
        font-size: Theme.font_body_large;
    }

    input := TextInput {
        x: 16px;
        y: 0;
        width: parent.width - 32px - (reveal-toggle ? 40px : 0px);
        height: parent.height;
        vertical-alignment: center;
        color: Theme.colors.on_surface;
        font-family: Theme.font_family;
        font-size: Theme.font_body_large;
        single-line: true;
        echo-mode: root.secret ? TextInput.password : TextInput.no-echo;
        accepted => { root.accepted(); }
    }

    // Суффикс: показать/скрыть пароль (глазик из фигур).
    if (reveal-toggle): Rectangle {
        x: parent.width - 40px;
        y: (parent.height - 24px) / 2;
        width: 32px;
        height: 24px;

        // Глаз: миндалевидная форма (ellipse) + зрачок.
        Rectangle {
            x: 6px;
            y: 7px;
            width: 20px;
            height: 10px;
            border-radius: Theme.corner_full;
            border-width: 1.5px;
            border-color: Theme.colors.on_surface_variant;
            background: transparent;
        }
        Rectangle {
            x: 13px;
            y: 10px;
            width: 6px;
            height: 6px;
            border-radius: Theme.corner_full;
            background: Theme.colors.on_surface_variant;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.revealed = !root.revealed; }
        }
    }
}
